# ============================================================
# Kredensial gateway (OpenAI-compatible)
# Salin file ini menjadi .env lalu isi nilainya.
# .env adalah BASELINE; config.json menang sebagai override runtime.
# ============================================================

# Kunci API gateway
API_KEY=

# Base URL endpoint (harus berakhir di /v1)
# Contoh: https://host-anda.example.com/v1
BASE_URL=

# Base URL cadangan, opsional. Dipakai bila BASE_URL gagal.
BASE_URL_CADANGAN=
